// tsconfig.server.common
{
    "extends": "./tsconfig.paths.json",
    "compilerOptions": {
        "allowJs": false,
        "esModuleInterop": true,
        "jsx": "react",
        "module": "CommonJS",
        "moduleResolution": "node",
        "noEmit": false,
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "rootDir": "../../src",
        "sourceMap": true,
        "strict": true,
        "target": "ES2020"
    },
    "exclude": ["../../src/client", "../../node_modules"],
    "include": ["../../src/server/**/*", "../../src/shared/**/*", "../../src/schemas/**/*"]
}
