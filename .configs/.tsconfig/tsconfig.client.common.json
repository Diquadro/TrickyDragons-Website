{
    "extends": "./tsconfig.paths.json",
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react",
        "module": "esnext",
        "moduleResolution": "node",
        "noImplicitAny": true,
        "rootDir": "../../src",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "esnext"
    },
    "exclude": ["../../src/server", "../../src/schemas", "../../src/database", "../../node_modules"],
    "include": ["../../src/client/**/*", "../../src/shared/**/*"]
}
