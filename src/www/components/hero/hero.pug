#hero
    picture#hero-image
        source(
            srcset='@www_imgs/hero_images/hero_image_landscape_desktop_v2_preload.webp?landscape',
            media='(min-width: 1400px)',
            fetchpriority='high'
        )
        source(
            srcset='@www_imgs/hero_images/hero_image_portrait_preload.webp?portrait',
            media='(max-width: 1400px)',
            fetchpriority='high'
        )
        img(
            src='@www_imgs/hero_images/hero_image_portrait_preload.webp?portrait',
            alt='hero image',
            width='auto',
            height='auto',
            loading='eager'
        )

    .content
        h3.slogan DRAW &bull; PLAY &bull; WIN

        h1.title= 'Tricky Dragons a Fast-Paced Card Game Where 2-6 Players Face Off In Unpredictable, Twist-Filled Games!'

        h2.subtitle !{ "Master the elements and outsmart your friends. Play your cards cleverly, disrupt the game, and edge closer to winning! <br/> <br/> Can you handle the power of <span class='font-bold'>Tricky Dragons</span>?" }

        #hero-infografic.hide-mobile
            picture
                source(srcset='@www_imgs/infografic/rsz_time.webp', type='image/webp', fetchpriority='high')
                img(
                    src='@www_imgs/infografic/rsz_time.webp',
                    alt='Playtime: 15 to 60 minutes',
                    width='100',
                    height='100',
                    loading='eager'
                )

            picture
                source(srcset='@www_imgs/infografic/rsz_age.webp', type='image/webp', fetchpriority='high')
                img(
                    src='@www_imgs/infografic/rsz_age.webp',
                    alt='Ages 10 and up',
                    width='100',
                    height='100',
                    loading='eager'
                )

            picture
                source(
                    srcset='@www_imgs/infografic/rsz_players.webp',
                    type='image/webp',
                    fetchpriority='high'
                )
                img(
                    src='@www_imgs/infografic/rsz_players.webp',
                    alt='Players: 2 to 6',
                    width='100',
                    height='100',
                    loading='eager'
                )

        include @www_components/cta/cta_hero.pug
