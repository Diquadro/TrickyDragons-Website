doctype html
html(lang='en')
    head
        include ./templates/_headers.pug

        link(rel='stylesheet', href='./landingpage.scss')

        include ../../components/google_analytics/google_analytics.pug
        include ../../components/meta_pixel/meta_pixel.pug
    body
        include ./templates/_cta_mixin.pug

        include ./templates/_hero.pug
        include ./templates/_feature_dragons.pug
        hr#hr-01.hr.hide-desktop
        include ./templates/_feature_elements.pug
        hr#hr-02.hr
        include ./templates/_feature_challenge.pug
        hr#hr-03.hr
        include ./templates/_feature_adventure.pug
        +cta('last-cta', 'START YOUR JOURNEY NOW!')
        include ./templates/_footer.pug

        include ./templates/_cta_modal.pug
        script(src='landingpage.ts') 
