doctype html
html(lang='en')
    head
        include ./components/html_head_tags/html_head_tags.pug

        link(rel='stylesheet', href='./landingpage.scss')
        link(rel='preconnect', href='https://fonts.googleapis.com')
        link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin='')
        link(
            rel='stylesheet',
            href='https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap'
        )

        include ../../components/google_analytics/google_analytics.pug
        include ../../components/meta_pixel/meta_pixel.pug
    body
        include ./components/cta/cta.pug

        include ./components/hero/hero.pug
        include ./components/feature_x1/feature_x1_dragons.pug
        hr#hr-01.hr.hide-desktop
        include ./components/feature_x1/feature_x1_elements.pug
        hr#hr-02.hr
        include ./components/feature_x2/feature_x2_challenge.pug
        hr#hr-03.hr
        include ./components/feature_x1/feature_x1_adventure.pug
        +cta('last-cta', 'START YOUR JOURNEY NOW!')
        include ./components/footer/footer.pug

        include ./components/cta_modal/cta_modal_email_duplicate.pug
        include ./components/cta_modal/cta_modal_email_sent.pug
        include ./components/cta_modal/cta_modal_email_reactivated.pug

        include ./components/spinner/spinner.pug

        script(src='./landingpage.ts', type='module') 
