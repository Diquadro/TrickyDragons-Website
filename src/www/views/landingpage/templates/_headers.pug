//- General
meta(charset='UTF-8')
meta(name='viewport', content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no')

//- Favicon standard
link(rel='icon', href='../../imgs/favicon/favicon.ico')

//- PNG Favicon
link(rel='icon', type='image/png', sizes='32x32', href='../../imgs/favicon/favicon-32x32.png')
link(rel='icon', type='image/png', sizes='16x16', href='../../imgs/favicon/favicon-16x16.png')

//- Apple Touch Icon
link(rel='apple-touch-icon', sizes='180x180', href='../../imgs/favicon/apple-touch-icon.png')

//- Manifest
//- link(rel='manifest', href='../site.webmanifest')

//- Canonical Link
link(rel='canonical', href='https://www.trickydragons.com/')

//- Hreflang 
link(rel='alternate', href='https://www.trickydragons.com/', hreflang='x-default')

//- Theme
meta(name='theme-color', content='#33ccff')
meta(name='apple-mobile-web-app-status-bar-style', content='#33ccff')

//- Meta Description
meta(
    name='description',
    content='Discover Tricky Dragons™, a fast-paced card game where strategy meets chaos! Master the elements and outsmart your friends. Coming soon on Kickstarter.'
)

//- Keywords
meta(
    name='keywords',
    content='Tricky Dragons™, card game, fantasy game, strategy game, Kickstarter games, board games, multiplayer card game, family-friendly games, quick card games, easy card games'
)

//- Author
meta(name='author', content='Daniele D\'Ambrosio')

//- Social Sharing (Open Graph)
meta(property='og:title', content='Tricky Dragons™ - A Fast-Paced Card Game')
meta(
    property='og:description',
    content='Outsmart your friends, master the elements, and dive into the chaos of Tricky Dragons™. Join us on Kickstarter!'
)
meta(property='og:image', content='https://www.trickydragons.com/assets/img/Open_Graph_1200x630.webp')
meta(property='og:url', content='https://www.trickydragons.com')
meta(property='og:type', content='website')

//- Twitter Card
meta(name='twitter:card', content='summary_large_image')
meta(name='twitter:title', content='Tricky Dragons™ - A Fast-Paced Card Game')
meta(
    name='twitter:description',
    content='Outsmart your friends, master the elements, and dive into the chaos of Tricky Dragons™. Join us on Kickstarter!'
)
meta(name='twitter:image', content='https://www.trickydragons.com/assets/img/Open_Graph_1200x630.webp')
