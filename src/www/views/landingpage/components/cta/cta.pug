mixin cta(id, title)
    +div_cta(id)
        h3.title= title
        p.subtitle
            span.font-bold Don&rsquo;t miss out!
            |
            | We&rsquo;ll notify you when the game launches, so you can grab limited early bird discounts!
        input(type='email', placeholder='Email Address', name='email', required)
        button.button(type='submit')
            span.font-black START YOUR ADVENTURE!

mixin div_cta(id)
    if id
        .cta(id=id)
            block
    else
        .cta
            block
