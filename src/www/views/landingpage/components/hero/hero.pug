include ../cta/cta.pug

#hero
    picture#hero-image
        source(
            srcset='../../imgs/hero_images/hero_image_landscape_desktop_v2.webp',
            media='(min-width: 1400px)'
        )
        source(srcset='../../imgs/hero_images/hero_image_portrait.webp', media='(max-width: 1400px)')
        img(src='../../imgs/hero_images/hero_image_portrait.webp', alt='hero image')

    .content
        h3.slogan DRAW &bull; PLAY &bull; WIN
        h1.title
            | Tricky Dragons a Fast-Paced Card Game Where 2-6 Players Face Off In Unpredictable, Twist-Filled Games!
        h2.subtitle
            | Master the elements and outsmart your friends. Play your cards cleverly, disrupt the game, and
            | edge closer to winning!
            br
            br
            |
            | Can you handle the power of the
            |
            span.font-bold Tricky Dragons
            |
            | ?
        #hero-infografic.hide-mobile
            img(src='../../imgs/infografic/rsz_time.webp', alt='playtime 15 to 60 minutes', loading='lazy')
            img(src='../../imgs/infografic/rsz_age.webp', alt='ages 10 and up', loading='lazy')
            img(src='../../imgs/infografic/rsz_players.webp', alt='players 2 to 6', loading='lazy')
        +cta('', 'COMING SOON ON KICKSTARTER')
