extends @client/layouts/layout_common/layout_common.pug

block head
    link(
        rel='preload',
        href='@public/imgs/thank-you-card.webp',
        as='image',
        type='image/webp',
        crossorigin='anonymous'
    )

block body
    .page-outer-layout
        .page-inner-layout
            .section-layout
                .image-layout
                    img(
                        src='@public/imgs/thank-you-card.webp',
                        alt='thank you for your support',
                        loading='eager',
                        crossorigin='anonymous'
                    )
                .text-layout
                    .title-layout
                        h2.subtitle SUCCESSFULLY UNSUBSCRIBED
                        h1.title THANKS FOR GIVING US A SHOT
                    p.description-layout
                        | We get it, inboxes get crowded.
                        br
                        span.bold Just so you know:
                        |
                        | Our email subscribers get the best deals and first access to everything Tricky Dragons.
                        br
                        br
                        span.bold Want to stay connected without emails?
                        |
                        | Follow us on
                        |
                        span.bold.instagram-link INSTAGRAM
                        |
                        | for the big announcements only.
                    .cta-layout
                        button.cta-main-button
                            a(href='/reservation') RESUBSCRIBE

            .footer-layout
                span A game by Daniele D'Ambrosio
                .links-layout
                    span.link
                        a(href='/privacy-policy') Privacy Policy
                    span.link
                        a(href='/terms-of-service') Terms of Service

    script(src='./unsubscribed.ts', type='module', defer) 
