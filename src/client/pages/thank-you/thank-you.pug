extends @client/layouts/layout_common/layout_common.pug

block head
    link(
        rel='preload',
        href='@public/imgs/thank-you-card.webp',
        as='image',
        type='image/webp',
        crossorigin='anonymous'
    )

block body
    .page-outer-layout
        .page-inner-layout
            .section-layout
                .image-layout
                    img(
                        src='@public/imgs/thank-you-card.webp',
                        alt='thank you for your support',
                        loading='eager',
                        crossorigin='anonymous'
                    )
                .text-layout
                    .title-layout
                        h2.subtitle THANK YOU FOR SIGNING UP!
                        h1.title YOUR SUPPORT MEANS THE WORLD TO US
                    p.description-layout
                        | A welcome email is on its way to you with more information about the game and the launch.
                        br
                        br
                        |
                        | Thank you for believing in our
                        |
                        span.bold Tricky Dragons
                        | , you'll be among the first to see them come to life!
                    .cta-layout
                        button.cta-main-button
                            a(href='https://www.kickstarter.com/projects/2076650099/tricky-dragons') FOLLOW OUR KICKSTARTER

            .footer-layout
                span A game by Daniele D'Ambrosio
                .links-layout
                    span.link
                        a(href='/privacy-policy') Privacy Policy
                    span.link
                        a(href='/terms-of-service') Terms of Service

    script(src='./thank-you.ts', type='module', defer) 
