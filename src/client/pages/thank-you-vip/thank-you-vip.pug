extends @client/layouts/layout_common/layout_common.pug

include @client/components/redirect_link/redirect_link.pug

block head
    link(
        rel='preload',
        href='@public/imgs/thank-you-card.webp',
        as='image',
        type='image/webp',
        crossorigin='anonymous',
        fetchpriority='high'
    )

block body
    .page-outer-layout
        .page-inner-layout
            .section-layout
                .image-layout
                    img(
                        src='@public/imgs/thank-you-card.webp',
                        alt='thank you for your support',
                        loading='eager',
                        crossorigin='anonymous',
                        fetchpriority='high',
                        width='600',
                        height='600'
                    )
                .text-layout
                    .title-layout
                        h1.title THANK YOU FOR YOUR SUPPORT!
                    p.description-layout
                        | You're now part of our exclusive inner circle!
                        br
                        |
                        |
                        | A confirmation email is on its way to you with more information about the game and the launch.
                        br
                        br
                        |
                        | Thank you for believing in
                        |
                        span.bold Tricky Dragons
                        | , you'll be among the first to see them come to life!
                    .cta-layout
                        button.cta-main-button
                            a(href='https://www.kickstarter.com/projects/2076650099/tricky-dragons') FOLLOW OUR KICKSTARTER

            .footer-layout
                span A game by Daniele D'Ambrosio
                .links-layout
                    span.link
                        a(href='/privacy-policy') Privacy Policy
                    span.link
                        a(href='/terms-of-service') Terms of Service

    script(src='./thank-you-vip.ts', type='module', defer) 
