extends @client/layouts/layout_common/layout_common.pug

block head
    link(
        rel='preload',
        href='@public/imgs/thank-you-card.webp',
        as='image',
        type='image/webp',
        crossorigin='anonymous',
        fetchpriority='high'
    )

block body
    .page-outer-layout
        .page-inner-layout
            .section-layout
                .image-layout
                    img(
                        src='@public/imgs/thank-you-card.webp',
                        alt='thank you for your support',
                        loading='eager',
                        crossorigin='anonymous',
                        fetchpriority='high',
                        width='600',
                        height='600'
                    )
                .text-layout
                    .title-layout
                        h1.title YOU'RE ALL SET FOR THE TRICKY DRAGONS LAUNCH
                    p.description-layout
                        | Thanks for joining our adventure. We'll keep you updated with all the exciting developments.
                        br
                        br
                        | If you need to contact us you can send an email to: info@trickydragons.com
                    .cta-layout
                        button.cta-main-button
                            a(href='https://www.kickstarter.com/projects/2076650099/tricky-dragons') FOLLOW OUR KICKSTARTER

            .footer-layout
                span A game by Daniele D'Ambrosio
                .links-layout
                    span.link
                        a(href='/privacy-policy') Privacy Policy
                    span.link
                        a(href='/terms-of-service') Terms of Service

    script(src='./welcome-back.ts', type='module', defer) 
