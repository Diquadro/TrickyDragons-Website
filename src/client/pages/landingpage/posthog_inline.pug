    const posthog = window.posthog
    const FEATURE_FLAG_NAME = 'hero_test'
    const STORAGE_KEY = 'ab_hero_variant'
    const TIMEOUT_INIT_MS = 500
    const TIMEOUT_FLAGS_MS = 500
    const QUERY_PARAM = 'ab_test'

    // 1. Check for query parameter override (for testing/preview)
    function check_query_param_override() {
        const urlParams = new URLSearchParams(window.location.search)
        const override = urlParams.get(QUERY_PARAM)
        if (override === 'control' || override === 'variant') {
            return override
        }
        return null
    }

    // 2. Check localStorage for stored variant (returning visitor)
    function check_stored_variant() {
        try {
            const stored = localStorage.getItem(STORAGE_KEY)
            if (stored === 'control' || stored === 'variant') {
                return stored
            }
        } catch (e) {
            // Silent fail
        }
        return null
    }

    // 3. Initialize PostHog and get feature flag (new visitor)
    async function get_variant_from_posthog() {
        // Only run PostHog on production domain
        if (window.location.hostname !== 'trickydragons.com') {
            return 'control'
        }

        try {
            // Initialize PostHog if not already loaded
            if (!posthog.__loaded) {
                await new Promise((resolve, reject) => {
                    const timeoutId = setTimeout(() => reject(new Error('PostHog init timeout')), TIMEOUT_INIT_MS)

                    posthog.init('phc_gv5ftx8FjCnhDNr3kEcXYPTZtqcSjR91357r6ePqod0', {
                        api_host: 'https://eu.i.posthog.com',
                        person_profiles: 'always',
                        session_recording: {
                            maskAllInputs: false,
                        },
                        loaded: () => {
                            clearTimeout(timeoutId)
                            resolve()
                        },
                    })
                })
            }

            // Wait for feature flags to load
            await new Promise((resolve, reject) => {
                const timeoutId = setTimeout(() => reject(new Error('Feature flags timeout')), TIMEOUT_FLAGS_MS)

                posthog.onFeatureFlags(() => {
                    clearTimeout(timeoutId)
                    resolve()
                })
            })

            // Get feature flag value: true = variant, false/undefined = control
            const isEnabled = posthog.isFeatureEnabled(FEATURE_FLAG_NAME)
            return isEnabled ? 'variant' : 'control'
        } catch (error) {
            // Silent fail, fallback to control
            return 'control'
        }
    }

    // 4. Save variant to localStorage
    function save_variant(variant) {
        try {
            localStorage.setItem(STORAGE_KEY, variant)
        } catch (e) {
            // Silent fail
        }
    }

    // 5. Show variant (control is already visible by default)
    function show_variant(variant) {
        if (variant === 'variant') {
            document.documentElement.classList.add('ab-variant')
        }
    }

    // Get A/B test variant with early returns
    async function get_variant() {
        // 1. Check query parameter override
        const override_variant = check_query_param_override()
        if (override_variant) return override_variant

        // 2. Check localStorage
        const stored_variant = check_stored_variant()
        if (stored_variant) return stored_variant

        // 3. Get from PostHog
        return await get_variant_from_posthog()
    }

    // Main A/B test flow
    async function main() {
        // Get variant with default fallback to control
        const variant = (await get_variant()) || 'control'

        // Track variant shown (only for new visitors from PostHog)
        const is_new_visitor = !check_query_param_override() && !check_stored_variant()
        if (is_new_visitor && window.location.hostname === 'trickydragons.com' && posthog.__loaded) {
            posthog.capture('ab_test_variant_shown', {
                test_name: FEATURE_FLAG_NAME,
                variant: variant,
            })
        }

        // Save to localStorage
        save_variant(variant)

        // Show the variant (only adds class if variant)
        show_variant(variant)
    }

    // Execute
    main()
