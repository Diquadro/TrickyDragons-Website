//- A/B Test: Inline script to preload image and show hero variant before body renders
script(nonce='posthog-ab-test').
    const STORAGE_KEY = 'ab_test_hero_image'
    const QUERY_PARAM = 'ab_test'

    // Valid variant values from query param
    const VALID_QUERY_VARIANTS = {
        hero_blue_box: 'ab_hero_blue_box',
        hero_red_box: 'ab_hero_red_box',
    }

    // Default variant (red box)
    const DEFAULT_VARIANT = 'ab_hero_red_box'

    /**
     * Preload hero image based on variant
     */
    function preload_hero_image(variant) {
        try {
            const imageUrl = variant === 'ab_hero_blue_box' ? '/imgs/landingpage/base_box_1_100.webp' : '/imgs/landingpage/kickstarter_box_7_100.webp'

            const link = document.createElement('link')
            link.rel = 'preload'
            link.href = imageUrl
            link.as = 'image'
            link.type = 'image/webp'
            link.crossOrigin = 'anonymous'
            link.fetchPriority = 'high'
            document.head.appendChild(link)
        } catch (e) {
            // Silent fail
        }
    }

    /**
     * Get variant from URL query parameter
     * Returns: 'ab_hero_blue_box' | 'ab_hero_red_box' | null
     */
    function get_query_variant() {
        try {
            const urlParams = new URLSearchParams(window.location.search)
            const queryValue = urlParams.get(QUERY_PARAM)

            if (queryValue && VALID_QUERY_VARIANTS[queryValue]) {
                return VALID_QUERY_VARIANTS[queryValue]
            }
        } catch (e) {
            // Silent fail
        }
        return null
    }

    /**
     * Get stored variant from localStorage (returning visitor)
     * Returns: 'ab_hero_blue_box' | 'ab_hero_red_box' | null
     */
    function get_stored_variant() {
        try {
            const stored = localStorage.getItem(STORAGE_KEY)
            if (stored === 'ab_hero_blue_box' || stored === 'ab_hero_red_box') {
                return stored
            }
        } catch (e) {
            // Silent fail
        }
        return null
    }

    /**
     * Save variant to localStorage for future visits
     */
    function save_variant(variant) {
        try {
            localStorage.setItem(STORAGE_KEY, variant)
        } catch (e) {
            // Silent fail
        }
    }

    /**
     * Apply CSS class to show the correct variant
     * Blue box requires class, red box is default (no class needed)
     */
    function apply_variant_class(variant) {
        if (variant === 'ab_hero_blue_box') {
            document.documentElement.classList.add('ab-hero-blue-box')
        }
        // Red box doesn't need a class (it's the default)
    }

    /**
     * Main A/B test logic
     */
    function main() {
        // Priority 1: Check query parameter (from Meta Ads)
        let variant = get_query_variant()

        // Priority 2: Check localStorage (returning visitor)
        if (!variant) {
            variant = get_stored_variant()
        }

        // Priority 3: Default to red box
        if (!variant) {
            variant = DEFAULT_VARIANT
        }

        // Preload the correct hero image
        preload_hero_image(variant)

        // Save to localStorage for future visits
        save_variant(variant)

        // Apply CSS class to show correct image
        apply_variant_class(variant)
    }

    // Execute immediately
    main()
