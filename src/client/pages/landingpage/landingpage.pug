extends @client/layouts/layout_common/layout_common.pug

block head
    link(
        rel='preload',
        href='@public/imgs/landingpage/hero_image_600_v4.webp',
        as='image',
        type='image/webp',
        crossorigin='anonymous',
        fetchpriority='high'
    )
    link(
        rel='preload',
        href='@public/imgs/landingpage/kickstarter_box_7_100.webp',
        as='image',
        type='image/webp',
        crossorigin='anonymous',
        fetchpriority='high'
    )
    //- Prefetch next critical images
    link(rel='prefetch', href='@public/imgs/3_dragons.webp', as='image', type='image/webp')
    link(rel='prefetch', href='@public/imgs/playing_viola_mano_5.webp', as='image', type='image/webp')
    link(
        rel='prefetch',
        href='@public/imgs/2026_01_16_Card_Wall_V02_100.webp',
        as='image',
        type='image/webp'
    )

    include posthog_inline.pug

block body
    main#page-container
        #hero.full-width
            .control.full-width.desktop-section-image-left.mobile-full-content
                h1.title THE ULTIMATE
                    |
                    |
                    span.no-wrap FAST-PACED
                    |
                    | CARD GAME WHERE CUTE DRAGONS MEET ELEMENTAL CHAOS

                h2.description Never judge a dragon by its cuteness!
                    br
                    |
                    |
                    | In
                    |
                    |
                    i Tricky Dragons
                    | , you will master the elements and command dragons in exciting battles. Prove yourself and become the trickiest dragon master!

                img.image(
                    src='@public/imgs/landingpage/hero_image_600_v4.webp',
                    alt='kickstarter box plus components',
                    loading='eager',
                    crossorigin='anonymous',
                    fetchpriority='high',
                    decoding='sync',
                    width='600',
                    height='600'
                )

            .variant.full-width.desktop-section-image-left.mobile-full-content
                img.image(
                    src='@public/imgs/landingpage/kickstarter_box_7_100.webp',
                    alt='kickstarter box',
                    loading='eager',
                    crossorigin='anonymous',
                    fetchpriority='high',
                    decoding='sync',
                    width='600',
                    height='600'
                )

                .text-container.description
                    h2
                        span 
                        |
                        | WARNING! IMPOSSIBLE TO PUT DOWN!
                    h1 WHEN STRATEGY
                        |
                        |
                        span MEETS CHAOS
                    p
                        span ADDICTIVE
                        |
                        | CARD GAME
                    p
                        span BEAUTIFUL
                        |
                        | ARTWORK
                    p
                        span FAST-PACED
                        |
                        | GAMEPLAY

        .cta.full-width.mobile-full-content
            h3 LAUNCHING IN MARCH
            p Sign up to be the first to know when we launch and receive
                |
                |
                span.exclusive-offer an exclusive mini expansion offer
                |
                | for our backers.
            form.cta-form
                input(
                    type='email',
                    name='email',
                    placeholder='Enter your email',
                    autocomplete='email',
                    required
                )
                input.form_name(type='text', name='name', autocomplete='off')
                //- label.checkbox-container
                //-     input(type='checkbox', name='newsletter_consent', required)
                //-     span I agree to receive the newsletter
                button(type='submit') UNLOCK THE EXCLUSIVE OFFER

        img#dragons-image(
            src='@public/imgs/3_dragons.webp',
            alt='3 dragons',
            loading='lazy',
            width='600',
            height='338'
        )

        .section.full-width.desktop-section-image-right-with-quote.mobile-full-content
            h3.title QUICK AND EASY ROUNDS, ONE CARD AT A TIME
            p.description Each turn, play a card that matches or beats the one on top.
                |
                |
                b But wait, there is a trick!
                |
                | Your dragons wield elemental powers that can flip the game.
            img.image(
                src='@public/imgs/playing_viola_mano_5.webp',
                alt='game preview',
                loading='lazy',
                width='600',
                height='600'
            )
            p.quote "Looks simple. Plays deep. I'm still discovering new strategies" - Alex N.

        .section.full-width.desktop-section-image-left.mobile-full-content
            h3.title FIRE BURNS GRASS
                br 
                | GRASS ABSORBS WATER
                br 
                | WATER EXTINGUISHES FIRE
            p.description At the heart of Tricky Dragons lies a simple elemental system, yet it transforms every card play into a meaningful tactical choice.
                |
                br
                br
                |
                | Low-value cards with the right element can be played on top of high-value cards. Suddenly, your worst hand becomes your best strategy.
            img.image(
                src='@public/imgs/element_card_circle_spread_8_100.webp',
                alt='Elemental system example',
                loading='lazy',
                width='600',
                height='600'
            )

        .section.full-width.desktop-section-image-right-with-quote.mobile-full-content
            h3.title.tw-wrap OVER 100
                |
                |
                span.no-wrap HAND-DRAWN
                |
                | DRAGONS BY ITALIAN ARTISTS
            p.description The deck bursts with colors, personalities, and details. Each dragon is unique and was designed to capture both elemental power and it's own style.
            img.image(
                src='@public/imgs/2026_01_16_Card_Wall_V02_100.webp',
                alt='wall of cards',
                loading='lazy',
                width='600',
                height='600'
            )
            p.quote "The dragon illustrations are adorable. I can't pick a favorite" - Maria D.

        #mid-cta.full-width.mobile-full-content
            h3.title BE AMONG THE FIRST & CLAIM THE MINI EXPANSION
            img.image(
                src='@public/imgs/mini_expnasion_pack_new_1_modified.webp',
                alt='mini expansion pack',
                loading='lazy',
                width='600',
                height='600'
            )

            .horizontal-divider.on-dark
                div

            .cta
                p Sign up to be the first to know when we launch, plus
                    |
                    |
                    span.exclusive-offer get the mini expansion at a special price
                    |
                    | if you reserve your copy.
                form.cta-form
                    input(
                        type='email',
                        name='email',
                        placeholder='Enter your email',
                        autocomplete='email',
                        required
                    )
                    input.form_name(type='text', name='name', autocomplete='off')
                    //- label.checkbox-container
                    //-     input(type='checkbox', name='newsletter_consent', required)
                    //-     span I agree to receive the newsletter
                    button(type='submit') DON'T MISS THE EXCLUSIVE OFFER

        #how-to-play.section.full-width.mobile-full-content
            h3.title HOW TO PLAY
            p.description
                b Draw Your Dragons
                | : Each player starts with a hand of elemental dragons, each with unique powers.
            img.image(
                src='@public/imgs/hand_with_cards.webp',
                alt='group playing',
                loading='lazy',
                width='919',
                height='741'
            )

            p.description
                b Play to the Arena
                | : Play your cards in turns, outplay your friends with the power of elements, and be the one to play the last card to win the round.
            img.image(
                src='@public/imgs/hand_playing_card_drawing.webp',
                alt='group playing',
                loading='lazy',
                width='1154',
                height='725'
            )

            p.description
                b Claim Your Victory
                | : Win Dragon Eggs each round. First to collect 7 eggs, becomes the Tricky Dragon Master.
            img.image(
                src='@public/imgs/trophy.webp',
                alt='group playing',
                loading='lazy',
                width='533',
                height='736'
            )

        .horizontal-divider.on-light
            div

        #quick-facts.section.full-width.mobile-full-content
            h3.title QUICK FACTS

            #infografic
                img(
                    src='@public/imgs/info_age.webp',
                    alt='info age',
                    loading='lazy',
                    width='297',
                    height='297'
                )
                img(
                    src='@public/imgs/info_time.webp',
                    alt='info time',
                    loading='lazy',
                    width='297',
                    height='297'
                )
                img(
                    src='@public/imgs/info_players.webp',
                    alt='info players',
                    loading='lazy',
                    width='297',
                    height='297'
                )

            ul.description
                li
                    span Learn in
                    |
                    |
                    b Just One Round!
                li
                    b 100+ Unique Effects
                    |
                    | for endeless combos!
                li
                    b Alternative Rules
                    |
                    | for every group.
                li
                    span Balanced for casual and competitive play.
                li
                    span A twist on classic trick-taking games.
                li
                    span Infinite replayability.

        p.quote.custom-quote “Every time a dragon effect was played, I felt an incredible thrill” - Louise F.

        #last-cta.cta.full-width.mobile-full-content
            h3.title JOIN 1000+ SUPPORTERS
            p.description Sign up to be the first to know when we launch and receive
                |
                |
                span.exclusive-offer an exclusive mini expansion offer
                |
                | for our backers.
            form.cta-form
                input(
                    type='email',
                    name='email',
                    placeholder='Enter your email',
                    autocomplete='email',
                    required
                )
                input.form_name(type='text', name='name', autocomplete='off')
                //- label.checkbox-container
                //-     input(type='checkbox', name='newsletter_consent', required)
                //-     span I agree to receive the newsletter
                button(type='submit') RESERVE YOUR DRAGON

            .footer-layout
                span A game by Daniele D'Ambrosio
                .links-layout
                    span.link
                        a(href='/privacy-policy') Privacy Policy
                    span.link
                        a(href='/terms-of-service') Terms of Service

    include @client/components/spinner/spinner
    script(src='./landingpage.ts', type='module', defer)
