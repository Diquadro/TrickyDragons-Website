extends @client/layouts/layout_common/layout_common.pug

block head
    link(
        rel='preload',
        href='@public/imgs/dragons_and_muffin.webp',
        as='image',
        type='image/webp',
        crossorigin='anonymous'
    )

block body
    .page-outer-layout
        .page-inner-layout
            .section-layout
                .image-layout
                    img(
                        src='@public/imgs/dragons_and_muffin.webp',
                        alt='reservation confirmed',
                        loading='eager',
                        crossorigin='anonymous'
                    )
                .text-layout
                    .title-layout
                        h2.subtitle THANK YOU FOR SIGNING UP!
                        h1.title WANT A BONUS MINI EXPANSION INCLUDED IN YOUR PLEDGE?
                    p.description-layout
                        | We are committed to making
                        |
                        span.bold Tricky Dragons
                        |
                        | the best game possible, but we need to understand the demand for it.
                        br
                        br
                        | To help us do so,
                        |
                        span.bold you can place a $1 refundable deposit now.
                        |
                        | In exchange, as a token of our gratitude, you'll receive the bonus mini expansion
                        |
                        span.bold "Dragons' Treasure: The Secret Recipe"
                        |
                        | when you pledge your copy of
                        |
                        span.bold Tricky Dragons
                        |
                        | starting at $29 on Kickstarter.
                    .cta-layout
                        button.cta-main-button
                            a(href='/checkout') CLAIM YOUR BONUS MINI EXPANSION
                        button.cta-secondary-button
                            a(href='/thank-you') No thanks, I'll just follow along.

            .divider

            .faqs-layout
                .faq-title-container
                    .faq-title FAQS
                    .faq-description These are the most commonly asked questions about our product, the reservation, and crowdfunding.
                .faq-items-layout
                    details.faq-item
                        summary.faq-question What does the $1 reservation do?
                        .faq-answer The crowdfunding scene is more crowded than ever. The $1 reservation helps us accurately measure demand before launching on Kickstarter, reducing risk and ensuring we can deliver a quality game on time. As a token of our gratitude for your early support, we're including the bonus mini expansion "Dragons' Treasure: The Secret Recipe" with your game at no extra cost.
                    details.faq-item
                        summary.faq-question What if I change my mind later?
                        .faq-answer Your $1 deposit is fully refundable anytime before the production begins. Simply contact us and we'll process your refund immediately. You'll still receive launch notifications and can back the campaign without the bonus.
                    details.faq-item
                        summary.faq-question If I reserve, do I still have to pledge on Kickstarter?
                        .faq-answer Yes! Your $1 reservation secures the bonus mini expansion, but you'll need to pledge for Tricky Dragons (starting at $24). The bonus expansion will be automatically added to your order.

            .infos-layout
                .info-item
                    img.info-icon(src='@public/imgs/refund.png', alt='Refund Icon')
                    .info-text
                        .info-title 100% Refund Guarantee
                        .info-description If you cancel your reservation, we guarantee you a full refund at any time before the project moves into production.
                .info-item
                    img.info-icon(src='@public/imgs/transparency.png', alt='Transparency Icon')
                    .info-text
                        .info-title Transparency Guarantee
                        .info-description We will be transparent about the progress of our project throughout the entire campaign.
                .info-item
                    img.info-icon(src='@public/imgs/secure.png', alt='Secure Icon')
                    .info-text
                        .info-title Secure Payment
                        .info-description All orders are processed through our secure network. Your credit card information is never stored in any way. We respect your privacy.

            .footer-layout
                span A game by Daniele D'Ambrosio
                .links-layout
                    span.link
                        a(href='/privacy-policy') Privacy Policy
                    span.link
                        a(href='/terms-of-service') Terms of Service

    script(src='./reservation.ts', type='module', defer) 
