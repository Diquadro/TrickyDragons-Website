extends @client/layouts/layout_common/layout_common.pug

block head
    link(
        rel='preload',
        href='@public/imgs/mini_expnasion_pack_new_1_modified.webp',
        as='image',
        type='image/webp',
        crossorigin='anonymous',
        fetchpriority='high'
    )

    script(src='https://js.stripe.com/basil/stripe.js')
    script(src='./checkout.ts', defer)

block body
    #page-container
        #main
            #reservation_image
                picture
                    img(
                        src='@public/imgs/mini_expnasion_pack_new_1_modified.webp',
                        alt='Tricky Dragons Mini Expansion Pack',
                        loading='eager',
                        crossorigin='anonymous',
                        fetchpriority='high',
                        decoding='sync',
                        width='300',
                        height='300',
                        style='max-width: 300px; max-height: 300px'
                    )
            #reservation_details
                .name Tricky Dragons Reservation
                .price $1

        #disclaimer
            #disclaimer_title Disclaimer
            #disclaimer_text Tricky Dragons is still in development and the final designs may change. The images for current editions are the latest prototypes that we have, and we will update you with any changes to appearance, cost, or function. Final prices are subject to change; we will notify you of any update before the campaign launches.

        //- Display a payment form
        form#payment-form.hidden
            #express-checkout-section
                #express-checkout-element
                    //- Stripe.js injects Express Checkout buttons here

                #express-checkout-separator
                    span Or

            #manual_checkout
                .section
                    span Email
                    input#email_address_input(type='email', disabled)

                .section
                    #billing-address-element
                        //- Stripe.js injects the Address Element

                .section
                    span Payment Information
                    #payment-element
                        //- Stripe.js injects the Payment Element

            button#submit
                span#button-text Pay
            //- #payment-message.hidden

        .footer-layout
            span A game by Daniele D'Ambrosio
            .links-layout
                span.link
                    a(href='/privacy-policy') Privacy Policy
                span.link
                    a(href='/terms-of-service') Terms of Service

    include @client/components/spinner/spinner.pug
