mixin cta(id, title)
    .cta(id=id)
        h3.title !{ title }
        p.subtitle Don't miss out on limited early bird discounts & launching date!

        form.cta-form
            input(type='email', placeholder='Email Address', name='email', autocomplete='email', required)

            label.checkbox-container
                input(type='checkbox', id=`consent-${id}`, name='consent', required)
                span.checkbox-text I agree to receive the newsletter.

            button.button(type='submit')
                span.font-black START YOUR ADVENTURE!

        p.members-count !{ '<span class="subscriber-count" data-target="0">0</span> Followers <span class="success-message hidden">and YOU ❤️</span>' }
