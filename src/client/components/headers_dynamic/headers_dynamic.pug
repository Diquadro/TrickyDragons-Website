//- Open Graph Meta Tags
meta(property='og:title', content=title)
meta(property='og:description', content=description)
meta(property='og:image', content=og_image)
meta(property='og:url', content='https://www.trickydragons.com/assets/imgs/hosted/Open_Graph_1200x630.webp')
meta(property='og:type', content='website')
meta(property='og:site_name', content='Tricky Dragons')
meta(property='og:locale', content='en_US')

//- Twitter Card
meta(name='twitter:card', content='summary_large_image')
meta(name='twitter:title', content=title)
meta(name='twitter:description', content=description)
meta(
    name='twitter:image',
    content='https://www.trickydragons.com/assets/imgs/hosted/Open_Graph_1200x630.webp'
)
meta(name='twitter:image:alt', content='Illustration of Tricky Dragons game')
meta(name='twitter:site', content='@TrickyDragons') 
meta(name='twitter:creator', content='@DanieleDAmbrosio') 

//- Meta Description
meta(name='description', content=description)

//- Keywords (se definiti)
if keywords
    meta(name='keywords', content=keywords.join(', '))

//- Robots meta tag
if robots
    meta(name='robots', content=robots)

//- Canonical Link
link(rel='canonical', href=url)

//- Page Title
title= title

//- Content-Security-Policy
- const is_dev = env === 'development'
- const script_src = ["'self'", "'nonce-beasties-critical-css-001'", "'nonce-datatables'", "'nonce-posthog-ab-test'", 'https://connect.facebook.net', 'https://cloud.umami.is', 'https://api-gateway.umami.dev', 'https://eu.i.posthog.com', 'https://eu-assets.i.posthog.com', 'https://js.stripe.com', 'https://cdn.mxpnl.com', 'https://analytics.tiktok.com']
- const style_src = ["'self'", "'unsafe-inline'", 'https://fonts.bunny.net', 'https://cdn.datatables.net', 'https://eu.i.posthog.com', 'https://us.posthog.com']
- const img_src = ["'self'", 'data:', 'https://www.facebook.com', 'https://*.stripe.com', 'https://eu-assets.i.posthog.com']
- const font_src = ["'self'", 'https://fonts.bunny.net']
- const frame_src = ["'self'", 'https://js.stripe.com', 'https://checkout.stripe.com', 'https://hooks.stripe.com', 'https://*.hcaptcha.com', 'https://*.stripecdn.com']
- const connect_src = ["'self'", 'https://graph.facebook.com', 'https://www.facebook.com', 'https://api.trickydragons.com', 'https://api-gateway.umami.dev', 'https://eu.i.posthog.com', 'https://eu-assets.i.posthog.com', 'https://internal-j.posthog.com', 'https://us.posthog.com', 'https://api.stripe.com', 'https://checkout.stripe.com', 'https://q.stripe.com', 'https://api-js.mixpanel.com', 'https://cdn.mxpnl.com', 'https://*.stripecdn.com', 'https://payments-eu.amazon.com', 'https://analytics.tiktok.com', 'https://*.tiktokw.us']
- if (is_dev) connect_src.push('https://dev-trickydragons-server.onrender.com')

meta(
    http-equiv='Content-Security-Policy',
    content=`default-src 'self'; script-src ${script_src.join(' ')}; style-src ${style_src.join(' ')}; img-src ${img_src.join(' ')}; font-src ${font_src.join(' ')}; frame-src ${frame_src.join(' ')}; connect-src ${connect_src.join(' ')}; object-src 'none'; upgrade-insecure-requests;`
)

//- Dev server prefetch
if is_dev
    link(rel='preconnect', href='https://dev-trickydragons-server.onrender.com')
