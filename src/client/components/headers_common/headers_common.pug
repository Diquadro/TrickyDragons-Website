//- General settings
meta(charset='UTF-8')
meta(name='viewport', content='width=device-width, initial-scale=1.0')

//- Favicon and Icons
link(rel='icon', href='@client/imgs/favicon/favicon.ico')
link(rel='icon', type='image/png', sizes='32x32', href='@client/imgs/favicon/favicon-32x32.png')
link(rel='icon', type='image/png', sizes='16x16', href='@client/imgs/favicon/favicon-16x16.png')
link(rel='apple-touch-icon', sizes='180x180', href='@client/imgs/favicon/apple-touch-icon.png')

//- link(rel='manifest', href='/site.webmanifest')

//- Default hreflang
link(rel='alternate', href='https://www.trickydragons.com/', hreflang='x-default')

//- Preconnect hints for external domains
link(rel='preconnect', href='https://cloud.umami.is', crossorigin)
link(rel='preconnect', href='https://api.trickydragons.com', crossorigin)
link(rel='preconnect', href='https://app.posthog.com', crossorigin)
link(rel='preconnect', href='https://connect.facebook.net', crossorigin)

//- Security Headers
meta(http-equiv='Strict-Transport-Security', content='max-age=31536000; includeSubDomains')
meta(name='referrer', content='no-referrer-when-downgrade')
meta(http-equiv='Permissions-Policy', content='geolocation=(), microphone=(), camera=()')

//- Font START

link(
    rel='preload',
    href='@client/fonts/Asap-VariableFont_wdth,wght.woff2',
    as='font',
    type='font/woff2',
    fetchpriority='high',
    loading='eager',
    crossorigin
)
