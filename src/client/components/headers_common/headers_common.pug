//- General settings
meta(charset='UTF-8')
meta(name='viewport', content='width=device-width, initial-scale=1.0')

//- Favicon and Icons
link(rel='icon', href='@client_imgs/favicon/favicon.ico')
link(rel='icon', type='image/png', sizes='32x32', href='@client_imgs/favicon/favicon-32x32.png')
link(rel='icon', type='image/png', sizes='16x16', href='@client_imgs/favicon/favicon-16x16.png')
link(rel='apple-touch-icon', sizes='180x180', href='@client_imgs/favicon/apple-touch-icon.png')

//- link(rel='manifest', href='/site.webmanifest')

//- Default hreflang
link(rel='alternate', href='https://www.trickydragons.com/', hreflang='x-default')

//- Security Headers
meta(http-equiv='Strict-Transport-Security', content='max-age=31536000; includeSubDomains')
meta(name='referrer', content='strict-origin-when-cross-origin')
meta(http-equiv='Permissions-Policy', content='geolocation=(), microphone=(), camera=()')

//- Font START
link(
    rel='preload',
    href='@client_fonts/Lexend-VariableFont_wght.woff2',
    as='font',
    type='font/woff2',
    crossorigin
)
