{
    "compilerOptions": {
        "outDir": "/",
        "sourceMap": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "module": "esnext",
        "target": "esnext",
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@client_components/*": ["src/client/components/*"],
            "@client_pages/*": ["src/client/pages/*"],
            "@client_layouts/*": ["src/client/layouts/*"],
            "@client_imgs/*": ["src/client/imgs/*"],
            "@client_ts/*": ["src/client/ts/*"],
            "@shared/*": ["src/shared/*"],
            "@server_controllers/*": ["src/server/controllers/*"],
            "@server_services/*": ["src/server/services/*"],
            "@server_routes/*": ["src/server/routes/*"],
            "@server_models/*": ["src/server/models/*"],
            "@server_middlewares/*": ["src/server/middlewares/*"],
            "@server_utils/*": ["src/server/utils/*"],
            "@server_emails/*": ["src/server/emails/*"]
        }
    }
}
