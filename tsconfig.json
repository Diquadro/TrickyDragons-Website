// tsconfig
{
    "compilerOptions": {
        "allowJs": true,
        "rootDir": "src",
        "baseUrl": ".",
        "esModuleInterop": true,
        "module": "CommonJS",
        "moduleResolution": "node",
        "paths": {
            "@client/*": [
                "src/client/*"
            ],
            "@database/*": [
                "src/database/*"
            ],
            "@server/*": [
                "src/server/*"
            ],
            "@shared/*": [
                "src/shared/*"
            ]
        },
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ESNext"
    },
    "include": [
        "./src"
    ],
    "exclude": [
        "./src/**/*.config.mjs"
    ]
}