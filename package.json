{
    "name": "trickydragons-webserver",
    "version": "1.0.0",
    "description": "trickydragons-webserver",
    "private": true,
    "scripts": {
        "watch:local": "concurrently --kill-others \"npm:watch:dev:*\"",
        "watch:local:client": "webpack serve --config .configs/.webpack/webpack.dev.mjs",
        "watch:local:server": "tsx watch --env-file=.env src/server/server.ts --tsconfig ./.configs/.tsconfig/tsconfig.server.json",
        "dev:client:build": "webpack --config .configs/.webpack/webpack.dev.mjs && node tools/critical_css.mjs",
        "dev:server:build": "node tools/build_server.mjs",
        "dev:server:start": "node dev/server/server.cjs",
        "prod:client:build": "webpack --config .configs/.webpack/webpack.prod.mjs && node tools/critical_css.mjs",
        "prod:server:build": "node tools/build_server.mjs",
        "prod:server:start": "node prod/server/server.mjs",
        "database:migrate": "node tools/migrations.mjs && npx kanel"
    },
    "author": "Daniele 'Diquadro' D'Ambrosio",
    "dependencies": {
        "base64url": "^3.0.1",
        "cors": "^2.8.5",
        "country-region-data": "^3.1.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-promise-router": "^4.1.1",
        "express-rate-limit": "^7.5.0",
        "geoip-lite": "^1.4.10",
        "isbot": "^5.1.20",
        "juice": "^11.0.0",
        "kanel": "^3.12.0",
        "kanel-zod": "^1.5.2",
        "morgan": "^1.10.0",
        "nodemailer": "^6.9.16",
        "postgres": "^3.4.5",
        "request-ip": "^3.3.0",
        "vanilla-cookieconsent": "^3.1.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@prettier/plugin-pug": "^3.2.0",
        "@types/cors": "^2.8.17",
        "@types/geoip-lite": "^1.4.4",
        "@types/morgan": "^1.9.9",
        "@types/nodemailer": "^6.4.17",
        "@types/pug": "^2.0.10",
        "@types/request-ip": "^0.0.41",
        "beasties": "^0.3.2",
        "compression-webpack-plugin": "^11.1.0",
        "concurrently": "^9.1.2",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^7.0.0",
        "esbuild": "^0.25.2",
        "esbuild-node-externals": "^1.18.0",
        "esbuild-plugin-clean": "^1.0.1",
        "esbuild-plugin-copy": "^2.1.1",
        "prettier": "^3.4.2",
        "prettier-plugin-css-order": "^2.1.2",
        "pug-plugin": "^5.3.0",
        "sass": "^1.83.1",
        "sass-loader": "^16.0.4",
        "terser-webpack-plugin": "^5.3.11",
        "ts-loader": "^9.5.1",
        "tsx": "^4.19.3",
        "typescript": "^5.7.2",
        "webpack": "^5.97.1",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.0",
        "webpack-merge": "^6.0.1"
    }
}
