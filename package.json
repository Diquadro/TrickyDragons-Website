{
    "name": "trickydragons-webserver",
    "version": "1.0.0",
    "description": "trickydragons-webserver",
    "private": true,
    "scripts": {
        "dist:client:build": "webpack --config .webpack/webpack.dist.js",
        "dist:server:build": "node server_build.js",
        "dist:server:start": "node dist/server/server.js",
        "watch:dev": "concurrently --kill-others \"npm:watch:dev:*\"",
        "watch:dev:serve": "webpack serve --config .webpack/webpack.dev.js",
        "watch:dev:server:start": "tsx watch --include ./src/api/**/* ./src/api/server.js",
        "dev:build": "webpack --config .webpack/webpack.dev.js"
    },
    "author": "Daniele 'Diquadro' D'Ambrosio",
    "type": "module",
    "dependencies": {
        "base64-url": "^2.3.3",
        "base64url": "^3.0.1",
        "cors": "^2.8.5",
        "country-region-data": "^3.1.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-promise-router": "^4.1.1",
        "express-rate-limit": "^7.5.0",
        "fs-extra": "^11.2.0",
        "geoip-lite": "^1.4.10",
        "isbot": "^5.1.20",
        "juice": "^11.0.0",
        "nodemailer": "^6.9.16",
        "nodemailer-express-handlebars": "^7.0.0",
        "postgres": "^3.4.5",
        "request-ip": "^3.3.0",
        "tsx": "^4.19.3",
        "vanilla-cookieconsent": "^3.1.0",
        "webpack-strip-block": "^0.3.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@prettier/plugin-pug": "^3.2.0",
        "@types/cors": "^2.8.17",
        "@types/geoip-lite": "^1.4.4",
        "@types/nodemailer": "^6.4.17",
        "@types/pug": "^2.0.10",
        "@types/request-ip": "^0.0.41",
        "compression-webpack-plugin": "^11.1.0",
        "concurrently": "^9.1.2",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^7.0.0",
        "kanel": "^3.11.1",
        "kanel-zod": "^1.5.1",
        "mini-css-extract-plugin": "^2.9.2",
        "nodemon": "^3.1.9",
        "prettier": "^3.4.2",
        "prettier-plugin-css-order": "^2.1.2",
        "pug-plugin": "^5.3.0",
        "sass": "^1.83.1",
        "sass-loader": "^16.0.4",
        "terser-webpack-plugin": "^5.3.11",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.2",
        "webpack": "^5.97.1",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.0",
        "webpack-merge": "^6.0.1",
        "webpack-node-externals": "^3.0.0"
    }
}
